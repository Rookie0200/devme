generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  emailVerified DateTime?
  image         String?
  name          String?
  accounts      Account[]
  sessions      Session[]
}

model SourceCodeEmbedding {
  id               String                      @id @default(uuid())
  summaryEmbedding Unsupported("vector(768)")?
  sourceCode       String
  fileName         String
  summary          String

  repositoryId String?
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


// ---------------------------------------------------------------------------
// Pull request review
// ---------------------------------------------------------------------------

/// A grant of access from a GitHub account to this application. The unit of
/// tenancy: provider keys and repositories belong to an Installation.
model Installation {
  id                   String    @id @default(uuid())
  githubInstallationId BigInt    @unique
  accountLogin         String
  accountType          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  /// Set when GitHub reports the installation was deleted. Rows are kept so
  /// that historical Review Runs stay readable.
  deletedAt            DateTime?

  repositories Repository[]
  providerKey  ProviderKey?
}

/// A GitHub repository reachable through an Installation. Discovered from
/// GitHub, never created by a person inside this application.
model Repository {
  id             String   @id @default(uuid())
  githubRepoId   BigInt   @unique
  owner          String
  name           String
  installationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Indexing is lazy — set the first time this repository produces a pull
  /// request, and again when the Codebase Index finishes building.
  indexingStartedAt DateTime?
  indexedAt         DateTime?

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  criteria             AcceptanceCriterion[]
  reviews              Review[]
  sourceCodeEmbeddings SourceCodeEmbedding[]

  @@unique([owner, name])
  @@index([installationId])
}

/// A single discrete obligation extracted from an Issue. Persisted against the
/// Issue rather than the Review Run, and keyed to `issueBodyHash` so that an
/// edited Issue re-extracts while an unedited one is reused.
model AcceptanceCriterion {
  id            String   @id @default(uuid())
  repositoryId  String
  issueNumber   Int
  issueTitle    String
  issueBodyHash String
  text          String
  ordinal       Int
  createdAt     DateTime @default(now())

  repository Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  results    CriterionResult[]

  @@index([repositoryId, issueNumber])
}

/// The ongoing assessment of one pull request. Holds the identifier of the
/// comment it owns so that every Review Run revises that comment in place.
model Review {
  id                String   @id @default(uuid())
  repositoryId      String
  pullRequestNumber Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// The single comment this Review owns on the pull request.
  commentId BigInt?

  /// The pull request's title, refreshed on every delivery so a renamed pull
  /// request reads correctly. Null only on Reviews that predate this column —
  /// the title was never in the payload we kept.
  title String?

  repository Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runs       ReviewRun[]

  @@unique([repositoryId, pullRequestNumber])
}

/// The record of one delivery's outcome against one specific head commit. A
/// Run may conclude without evaluating anything: an Unlinked pull request or
/// an Installation with no Provider Key produces a Run recording the decline.
model ReviewRun {
  id          String          @id @default(uuid())
  reviewId    String
  headSha     String
  status      ReviewRunStatus @default(running)
  model       String?
  /// What this Run spent. Null means unknown — a Run that failed somewhere we
  /// could not account for — and is deliberately distinct from `0`, which
  /// means it ended before any model call.
  costUsd     Float?
  startedAt   DateTime        @default(now())
  completedAt DateTime?

  /// Why the Run ended as it did: `unlinked`, `no_provider_key`,
  /// `provider_auth`, `provider_unavailable`, `github_error`, `internal`.
  /// Null on a completed Run and on rows predating outcome recording.
  ///
  /// A `String` narrowed by a TypeScript union rather than an enum: this set
  /// is expected to grow, and each new value would otherwise be a migration
  /// against production. Same reasoning as `Finding.producer`.
  outcomeReason String?

  /// The `X-GitHub-Delivery` id of the webhook delivery that most recently
  /// owns this Run — set on creation and refreshed on takeover, so a manual
  /// retry always redelivers the delivery GitHub would retry itself. Null on
  /// rows that predate retry support.
  githubDeliveryId String?

  review   Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  results  CriterionResult[]
  findings Finding[]

  /// Also the duplicate-delivery guard: a second delivery for a head commit
  /// already processed cannot create a second Run.
  @@unique([reviewId, headSha])
}

/// The verdict a Review Run reached on one Acceptance Criterion, with the
/// Evidence supporting it.
model CriterionResult {
  id          String           @id @default(uuid())
  reviewRunId String
  criterionId String
  verdict     CriterionVerdict
  evidence    String

  /// Where the Verifier located the Evidence. Absent for an absence claim,
  /// which has no line to point at.
  evidenceFile      String?
  evidenceStartLine Int?
  evidenceEndLine   Int?

  reviewRun ReviewRun           @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  criterion AcceptanceCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([reviewRunId, criterionId])
}

/// An observation not tied to an Acceptance Criterion. Sparse at MVP because
/// only one Producer exists; the table is here so a second Producer is additive.
model Finding {
  id          String @id @default(uuid())
  reviewRunId String
  producer    String
  body        String

  evidenceFile      String?
  evidenceStartLine Int?
  evidenceEndLine   Int?

  reviewRun ReviewRun @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)

  @@index([reviewRunId])
}

/// An Installation's model credential. Encrypted with AES-256-GCM under a
/// master key held in the environment; the plaintext is never stored, logged,
/// or returned to a client.
model ProviderKey {
  id             String   @id @default(uuid())
  installationId String   @unique
  provider       String
  ciphertext     String
  iv             String
  authTag        String
  /// Last four characters of the plaintext, for display only.
  hint           String
  validatedAt    DateTime?
  /// When a real Review Run was refused by the provider on this credential.
  /// Set by the pipeline, cleared when a key is saved, and destroyed with the
  /// key — so the warning it drives cannot outlive what it is about. Only ever
  /// set for a refused credential, never for a provider that was unreachable.
  lastAuthFailureAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
}

enum ReviewRunStatus {
  running
  completed
  failed
  declined
}

enum CriterionVerdict {
  satisfied
  unsatisfied
  unclear
}
