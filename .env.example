# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma. Postgres with the pgvector extension.
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/devme"

# Auth.js
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth — dashboard identity only. Grants no repository access.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# The GitHub App that posts reviews. Register a throwaway development App
# pointing at a tunnel, and a separate production App on the VM.
GITHUB_APP_ID=""
# PEM contents. Newlines may be written as literal "\n".
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Wraps every Provider Key at rest. 32 random bytes, base64-encoded:
#   openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""

# BullMQ. Colocated with the app on the same host.
REDIS_URL="redis://localhost:6379"

# Indexing — paid for by the platform, not by the customer's Provider Key.
GROQ_API_KEY=""
GROQ_CHAT_MODEL=""
HF_TOKEN=""

# Legacy, still required until the meeting cluster is purged.
ASSEMBLYAI_API_KEY=""
